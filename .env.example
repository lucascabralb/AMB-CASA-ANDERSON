# Copie este arquivo para ".env" (mesma pasta) e preencha com suas credenciais reais.
# O main.py/tuya_service.py já lê essas variáveis automaticamente via os.environ.
# Para funcionar sem instalar nada extra, exporte-as no terminal antes de rodar:
#   export TUYA_CLIENT_ID=mar833ptq3ja3fstcwdg
#   export TUYA_SECRET=27af5f3873a04fd191e1057615656d7a
#   uvicorn main:app --host 0.0.0.0 --port 8000
# Ou instale python-dotenv (pip install python-dotenv) e adicione no topo do
# main.py: from dotenv import load_dotenv; load_dotenv()

TUYA_CLIENT_ID=mar833ptq3ja3fstcwdg
TUYA_SECRET=27af5f3873a04fd191e1057615656d7a
TUYA_BASE_URL=https://openapi.tuyaus.com
